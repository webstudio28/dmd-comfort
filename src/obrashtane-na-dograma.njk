    {% set faqs = [
      { q: "Може ли обръщане без смяна на дограмата?", a: "Възможно е при подходящо състояние на съществуващите прозорци и отвора. Проверяват се размерите, основата и възможността профилите да бъдат монтирани, без да пречат на крилата и обкова." },
      { q: "Подходящо ли е за PVC и алуминиева дограма?", a: "Съществуват системи за завършване около двата вида дограма. Подходящият вариант се уточнява според избраните профили, размерите на отвора и начина на монтаж." },
      { q: "Трябва ли да се боядисва след монтажа?", a: "Готовите профили имат завършена повърхност. Ако стената извън покритата зона е повредена, за нея може да бъде нужна отделна обработка и боядисване. Този обхват се уточнява предварително." },
      { q: "Има ли прах и разчистване?", a: "При подготовката и разкрояването може да има прах и отпадъци. Количеството зависи от състоянието на отвора. Готовите профили ограничават довършителните операции върху самата облицована повърхност, но не отменят подготовката." },
      { q: "Може ли да остане съществуващият перваз?", a: "Това зависи от състоянието, размерите и закрепването му. При огледа се проверява как новите профили ще се свържат с перваза и дали е необходимо допълнително оформяне." },
      { q: "Подходящи ли са профилите за външно обръщане на прозорци?", a: "На тази страница представяме вътрешно обръщане. За външно приложение са необходими продукти и монтажни детайли, изрично предназначени за атмосферно въздействие. Интериорният профил не е автоматично подходящ за фасада — решението се проверява по документацията на конкретната система." },
      { q: "Обръщането ще реши ли проблем с теч или конденз?", a: "Самото покриване на отвора не е диагноза или решение на причината. Ако има влага, теч или повреда около дограмата, първо трябва да се установи източникът и да се уточнят необходимите действия." },
      { q: "Как се поддържат PVC профилите?", a: "Следвайте указанията на производителя за конкретното покритие. Избягвайте абразиви и агресивни препарати, които не са предназначени за тази повърхност." },
      { q: "Какви са срокът и гаранционните условия?", a: "Срокът зависи от обхвата и необходимата подготовка. Условията за материала и изпълнението се уточняват в конкретната оферта преди започване на работата." }
    ] %}
