  { q: "Трябва ли да боядисвам след монтажа?", a: "Самите готови профили не изискват боядисване. Ако стената извън зоната, която покриват, е повредена или незавършена, за нея може да бъдат необходими отделни довършителни работи." },
  { q: "Може ли да се запази подпрозоречният перваз?", a: "Това зависи от неговото състояние, размери и закрепване. При измерването се уточнява как профилите ще се свържат със съществуващия перваз." },
  { q: "Има ли прах по време на работата?", a: "При подготовка на основата и разкрояване на материалите може да се образуват прах и отпадъци. Методът използва готова довършителна повърхност, но необходимата подготовка зависи от конкретния отвор." },
  { q: "Колко време отнема изпълнението?", a: "Срокът зависи от броя и размерите на отворите, състоянието на основата и необходимите допълнителни дейности. Уточнява се заедно с обхвата на работата." },
  { q: "Предлагате ли обръщане на врати?", a: "Да. Можете да заявите и обръщане на врати с PVC профили. Възможността за изпълнение се проверява спрямо касата, стената и размерите на отвора." },
  { q: "Подходящи ли са тези профили за външно обръщане?", a: "Представената услуга е за вътрешно обръщане. Външното приложение изисква материали и монтажно решение, предназначени за съответните атмосферни условия." },
  { q: "Как да поискам оферта?", a: "Изпратете запитване с населеното място, броя прозорци или врати и кратко описание на състоянието им. Ако разполагате със снимки и приблизителни размери, добавете и тях за първоначална преценка." },
  { q: "Работите ли по обекти извън Пловдив?", a: "Да, приемаме запитвания и за обекти в други населени места в България. Възможността и условията за изпълнение се уточняват според местоположението и обхвата на работата." }
] %}
<section class="trim-section trim-section-soft" id="vaprosi" aria-labelledby="trim-faq-title" data-faq>
  <div class="container-site">
    <div class="trim-faq-head">
      <h2 class="trim-heading" id="trim-faq-title">Често задавани въпроси</h2>
      <p>Отговори на основните въпроси за обръщането с PVC профили, подготовката и изпълнението.</p>
    </div>
    <div class="trim-faq-list">
      <div class="trim-faq-stack">
        {% for faq in faqs %}{% if loop.index0 < 7 %}{{ faqItem(faq) }}{% endif %}{% endfor %}
      </div>
      {% if faqs.length > 7 %}
      <div class="trim-faq-extra" data-faq-extra>
        <div class="trim-faq-extra-inner trim-faq-stack" data-faq-extra-inner>
          {% for faq in faqs %}{% if loop.index0 >= 7 %}{{ faqItem(faq) }}{% endif %}{% endfor %}
        </div>
        <div class="trim-faq-extra-fade" aria-hidden="true"></div>
      </div>
      <div class="trim-faq-more-wrap">
        <button class="trim-faq-more" type="button" data-faq-expand aria-expanded="false" data-label-more="Вижте още" data-label-less="Вижте по-малко">
          <span data-faq-expand-label>Вижте още</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>
      </div>
      {% endif %}
    </div>
  </div>
</section>

<section class="trim-contact" id="zapitvane" aria-labelledby="trim-contact-title"><div class="container-site trim-contact-grid">
  <div><h2 id="trim-contact-title">Поискайте оферта за завършване около вашите прозорци</h2><p>За нови и вече монтирани прозорци в Пловдив и страната.</p></div>
  <div class="trim-contact-actions"><button class="btn btn-primary open-inquiry" type="button">Поискайте оферта {{ arrow() }}</button></div>
</div></section>

{% set serviceUrl = site.seo.siteUrl + (page.url | url) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Service",
      "@id": {{ (serviceUrl + '#service') | dump | safe }},
      "name": "ПВЦ профили за обръщане на прозорци",
      "serviceType": "Вътрешно обръщане на прозорци и врати с PVC профили",
      "description": {{ description | dump | safe }},
      "url": {{ serviceUrl | dump | safe }},
      "image": {{ (site.seo.siteUrl + (pageImage | url)) | dump | safe }},
      "areaServed": [
        { "@type": "City", "name": "Пловдив" },
        { "@type": "Country", "name": "България" }
      ],
      "provider": { "@type": "Organization", "name": {{ site.brand.name | dump | safe }}, "url": {{ site.seo.siteUrl | dump | safe }} }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Начало", "item": {{ (site.seo.siteUrl + ('/' | url)) | dump | safe }} },
        { "@type": "ListItem", "position": 2, "name": "Услуги", "item": {{ (site.seo.siteUrl + ('/uslugi/' | url)) | dump | safe }} },
        { "@type": "ListItem", "position": 3, "name": "Обръщане с PVC первази", "item": {{ serviceUrl | dump | safe }} }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs %}
        {
          "@type": "Question",
          "name": {{ faq.q | dump | safe }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ faq.a | dump | safe }}
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  ]
}
</script>
