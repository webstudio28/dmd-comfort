{# data-frequency="daily" shows the banner once per calendar day in this browser. Use "every-load" to preview it on every page view. #}
<div class="pointer-events-none invisible fixed inset-0 z-[140] grid place-items-center overflow-y-auto p-4 sm:p-6" id="blackFridayBanner" data-frequency="daily" aria-hidden="true">
  <div class="absolute inset-0 bg-black/40 opacity-0 backdrop-blur-sm transition duration-300" data-bf-backdrop data-close-bf></div>
  <div class="relative my-auto flex h-[80vh] w-full max-h-[80vh] max-w-4xl translate-y-3 flex-col overflow-hidden rounded-[22px] border border-brand/35 bg-brand-deeper opacity-0 shadow-[0_40px_120px_rgba(0,0,0,0.7)] transition duration-300 md:grid md:h-auto md:max-h-none md:min-h-[440px] md:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]" data-bf-card role="dialog" aria-modal="true" aria-labelledby="bfTitle">
    <div class="pointer-events-none absolute -right-20 -top-24 h-56 w-56 rounded-full bg-brand/25 blur-3xl" aria-hidden="true"></div>
    <button class="absolute right-3 top-3 z-10 grid h-10 w-10 place-items-center rounded-full border border-white/20 bg-black/55 text-white backdrop-blur-sm transition hover:bg-black/75" type="button" data-close-bf aria-label="Затвори">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <div class="relative h-36 shrink-0 md:h-auto md:min-h-full">
      <img
        class="absolute inset-0 h-full w-full object-cover"
        src="{{ '/assets/images/hero.webp' | url }}"
        alt=""
        width="1200"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-brand-deeper via-brand-deeper/25 to-black/10 md:bg-gradient-to-r md:from-black/10 md:via-transparent md:to-brand-deeper" aria-hidden="true"></div>
    </div>
    <div class="relative flex min-h-0 flex-1 flex-col justify-center px-5 py-5 sm:px-8 sm:py-8">
      <h2 id="bfTitle" class="font-display text-[1.85rem] font-black leading-[1.05] tracking-wide text-white md:text-[clamp(2rem,3.5vw,2.85rem)] md:leading-[1.02]">
        <span class="mr-2 inline-block origin-center -rotate-6 rounded-xl bg-red-600 px-2.5 py-1 align-middle text-[2.35rem] leading-none tracking-tight text-white shadow-[0_10px_28px_rgba(220,38,38,0.45)] md:mr-2.5 md:px-3 md:py-1.5 md:text-[clamp(2.55rem,5vw,3.7rem)]">−10%</span>Отстъпка за всички услуги през Ноември
      </h2>
      <p class="mt-3 max-w-md text-base leading-relaxed text-white/70 md:mt-4">10% отстъпка за дограма, врати, щори, обръщане и монтаж — за всяка услуга на ДМД Комфорт.</p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row md:mt-7">
        <a class="btn btn-primary" href="{{ site.contact.phoneHref }}" data-close-bf>Обади ни се</a>
        <a class="btn btn-light" href="{{ '/uslugi/' | url }}" data-close-bf>Виж всички услуги</a>
      </div>
    </div>
  </div>
</div>
