{% macro serviceImage(item, className="", eager=false) %}
  {% if item.image and not item.imageMissing %}
    <img
      class="image-cover {{ className }}"
      src="{{ item.image | url }}"
      alt="{{ item.imageAlt or item.title }}"
      {% if item.imageWidth and item.imageHeight %}width="{{ item.imageWidth }}" height="{{ item.imageHeight }}"{% endif %}
      {% if item.imageFit == "contain" %}style="object-fit: contain; background: #edf1ed"{% endif %}
      {% if eager %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}
    />
  {% else %}
    <div class="service-image-missing {{ className }}" role="img" aria-label="Липсва снимка за {{ item.title }}">
      <span class="service-image-missing-badge">Липсва снимка</span>
      <span class="service-image-missing-title">{{ item.title }}</span>
    </div>
  {% endif %}
{% endmacro %}
