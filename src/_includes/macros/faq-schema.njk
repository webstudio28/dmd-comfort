{# FAQPage JSON-LD. Expects list of { q, a }. #}
{% macro faqSchema(faqs) %}
{% if faqs and faqs.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ (f.a or f.answer) | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% endif %}
{% endmacro %}
