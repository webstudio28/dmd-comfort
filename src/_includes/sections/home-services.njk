{% from "macros/service-image.njk" import serviceImage %}
<section class="section-pad overflow-x-clip bg-[#f3f3f3] home-mobile-center">
  <div class="container-site">
    <div class="section-head mb-10 flex flex-col items-center justify-between gap-6 md:mb-12 md:flex-row md:items-end reveal">
      <div>
        <div class="eyebrow">Нашите услуги</div>
        <h2 class="section-title">Решения за комфорт у дома</h2>
        <p class="section-copy">Дограма, врати, плъзгащи системи, щори и метални конструкции - подбрани според обекта ви.</p>
      </div>
      <a class="arrow-link" href="{{ '/uslugi/' | url }}">Всички услуги
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>

  <div class="container-site max-md:contents">
    <div class="h-scroll reveal md:grid md:grid-cols-2 lg:grid-cols-4">
      {% for s in catalogServices %}
        <article class="card">
          <div class="relative m-3 aspect-[4/3] overflow-hidden rounded-lg bg-[#ececec]">
            {{ serviceImage(s, "h-full w-full") }}
            <span class="absolute left-3 top-3 grid h-9 w-9 place-items-center rounded-lg bg-brand font-display text-[13px] font-extrabold text-white">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</span>
          </div>
          <div class="border-t border-ink/10 px-5 pb-6 pt-4">
            <h3 class="mb-2 font-display text-[22px] font-extrabold tracking-wide">{{ s.title }}</h3>
            {% if s.shortDescription %}
              <p class="mb-4 text-[15px] leading-relaxed text-ink-muted">{{ s.shortDescription }}</p>
            {% endif %}
            {% if s.menuChildren and s.menuChildren.length %}
              <p class="mb-4 text-[15px] leading-relaxed text-ink-muted">
                {% for child in s.menuChildren %}<a class="text-ink underline underline-offset-4 decoration-ink/20 hover:text-brand" href="{{ ('/uslugi/' + child.slug + '/') | url }}">{{ child.title }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}
              </p>
            {% endif %}
            <a class="font-display text-sm font-extrabold uppercase tracking-[0.08em] text-brand underline underline-offset-4" href="{{ (s.href or ('/uslugi/' + s.slug + '/')) | url }}">Разгледай →</a>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
