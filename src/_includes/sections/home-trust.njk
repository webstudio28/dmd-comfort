<section class="relative z-[3] border-y border-ink/10 bg-[#e6ebe8]" aria-label="Нашите предимства">
  <div class="container-site grid grid-cols-2 lg:grid-cols-4">
    {% for item in home.trust %}
      <div class="flex items-center gap-3.5 border-ink/10 px-2 py-6 sm:px-4 {% if not loop.last %}border-r{% endif %} {% if loop.index0 < 2 %}border-b lg:border-b-0{% endif %}">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-[11px] bg-white text-brand shadow-sm">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z M8 12l2.5 2.5L16 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <div>
          <strong class="block font-display text-[17px] font-extrabold leading-tight">{{ item.title }}</strong>
          <small class="mt-1 block text-xs leading-snug text-ink-muted">{{ item.text }}</small>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
