<section class="section-pad bg-[#f3f3f3]">
  <div class="container-site grid items-center gap-6 lg:grid-cols-2 lg:gap-x-14 lg:gap-y-0">
    <div class="reveal order-1 lg:col-start-2 lg:row-start-1">
      <div class="eyebrow">{{ home.aboutTeaser.eyebrow }}</div>
      <h2 class="section-title">Правилната дограма започва с <span class="text-brand">правилния избор</span></h2>
    </div>

    <div class="relative order-2 reveal lg:col-start-1 lg:row-span-2 lg:row-start-1">
      <img
        class="aspect-square w-full rounded-[13px] object-cover shadow-lift md:aspect-[4/5] md:max-h-[540px]"
        src="{{ '/assets/images/about-home.webp' | url }}"
        alt="Димитър Димитров — основател и управител на ДМД Комфорт"
        width="1254"
        height="1254"
        loading="lazy"
      />
      <div class="absolute bottom-4 left-1/2 w-[48%] -translate-x-1/2 rounded-xl bg-brand px-3.5 py-4 text-center text-white shadow-[0_10px_28px_rgba(5,114,48,0.28)] md:bottom-5 md:w-[42%] md:px-4 md:py-4">
        <span class="block font-display text-[10px] font-bold uppercase tracking-[0.1em] md:text-[11px]">Заедно с вас повече от</span>
        <strong class="mt-1 block font-display text-xl font-black leading-none tracking-wide md:text-2xl">20 ГОДИНИ</strong>
      </div>
    </div>

    <div class="reveal order-3 lg:col-start-2 lg:row-start-2 lg:mt-5">
      <div class="rounded-r-xl border-l-4 border-brand bg-gradient-to-br from-ink/[0.06] to-ink/[0.03] px-5 py-5 font-display text-xl font-bold leading-snug">{{ home.aboutTeaser.mission }}</div>
      <p class="mb-7 mt-6 text-[17px] leading-relaxed text-ink-muted">{{ home.aboutTeaser.text }}</p>
      <a class="btn btn-primary" href="{{ '/za-nas/' | url }}">Повече за нас</a>
    </div>
  </div>
</section>
