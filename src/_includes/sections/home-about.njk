<section class="section-pad bg-white">
  <div class="container-site grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="relative min-h-[390px] reveal md:min-h-[540px]">
      <img class="h-[350px] w-[88%] rounded-[13px] object-cover shadow-lift md:h-[500px]" src="https://images.unsplash.com/photo-1503387762-592deb58ef4e?w=1000&q=80" alt="Професионална работа по дограма" loading="lazy" />
      <img class="absolute bottom-0 right-0 h-40 w-[45%] rounded-[13px] border-[6px] border-white object-cover shadow-lift md:h-[220px] md:border-8" src="https://images.unsplash.com/photo-1600607687644-c7171b42498b?w=800&q=80" alt="Детайл от монтаж" loading="lazy" />
      <div class="absolute right-0 top-6 w-[108px] rounded-xl bg-brand px-3.5 py-4 text-center text-white shadow-[0_10px_28px_rgba(61,122,92,0.28)] md:top-8 md:w-[130px] md:px-3.5 md:py-4">
        <strong class="block font-display text-3xl font-black leading-none md:text-[34px]">{{ site.brand.foundedYear }}</strong>
        <span class="mt-1 block font-display text-[11px] font-bold uppercase tracking-[0.12em]">Заедно с вас от</span>
      </div>
    </div>
    <div class="reveal">
      <div class="eyebrow">{{ home.aboutTeaser.eyebrow }}</div>
      <h2 class="section-title">Правилната дограма започва с <span class="text-brand">правилния избор</span></h2>
      <div class="my-6 rounded-r-xl border-l-4 border-brand bg-gradient-to-br from-brand/10 to-ink/5 px-5 py-5 font-display text-xl font-bold leading-snug">{{ home.aboutTeaser.mission }}</div>
      <p class="mb-7 text-[17px] leading-relaxed text-ink-muted">{{ home.aboutTeaser.text }}</p>
      <a class="btn btn-primary" href="{{ '/za-nas/' | url }}">Повече за нас</a>
    </div>
  </div>
</section>
