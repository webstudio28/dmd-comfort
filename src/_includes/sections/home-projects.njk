<section class="section-pad section-band-lined overflow-x-clip" aria-labelledby="home-projects-title">
  <div class="container-site mb-10 flex flex-col gap-6 reveal md:mb-12 md:flex-row md:items-end md:justify-between">
    <div>
      <div class="eyebrow">Реализирани проекти</div>
      <h2 class="section-title" id="home-projects-title">Вижте част от нашата работа</h2>
      <p class="section-copy">Реални обекти с внимание към комфорта и детайла.</p>
    </div>
    <a class="btn btn-primary hidden shrink-0 self-start md:inline-flex md:self-auto" href="{{ '/proekti/' | url }}">Всички проекти</a>
  </div>

  <div class="overflow-x-clip py-6 md:py-8">
    <div class="h-scroll-drag reveal" data-drag-scroll tabindex="0" role="region" aria-label="Категории проекти — плъзнете хоризонтално">
      {% for group in projectGroups %}
        <a class="card group block no-underline" href="{{ group.href | url }}" draggable="false">
          <div class="relative m-2.5 aspect-[4/3] overflow-hidden rounded-lg">
            <img
              class="image-cover"
              src="{{ group.image | url }}"
              alt="{{ group.title }}"
              width="640"
              height="480"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
          <div class="border-t border-ink/10 px-4 pb-5 pt-3.5">
            <h3 class="mb-1.5 font-display text-lg font-extrabold leading-snug text-ink group-hover:text-brand">{{ group.title }}</h3>
            <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{{ group.countLabel }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>

  <div class="container-site md:hidden">
    <a class="btn btn-primary" href="{{ '/proekti/' | url }}">Всички проекти</a>
  </div>
</section>
