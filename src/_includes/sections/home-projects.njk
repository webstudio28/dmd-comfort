<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 flex flex-col items-start justify-between gap-6 md:mb-12 md:flex-row md:items-end reveal">
      <div>
        <div class="eyebrow">Реализирани проекти</div>
        <h2 class="section-title">Вижте част от нашата работа</h2>
        <p class="section-copy">Реални обекти с внимание към комфорта и детайла.</p>
      </div>
      <a class="arrow-link" href="{{ '/proekti/' | url }}">Всички проекти
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {% for p in projects %}
        <a class="project-tile reveal group relative block min-h-[280px] overflow-hidden rounded-xl text-white no-underline" href="{{ ('/proekti/' + p.slug + '/') | url }}">
          <img class="image-cover absolute inset-0" src="{{ p.images[0] }}" alt="{{ p.title }}" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#121516]/90 via-[#121516]/25 to-transparent"></div>
          <div class="absolute inset-x-6 bottom-5 z-[2]">
            <h3 class="mb-1 font-display text-[22px] font-extrabold">{{ p.title }}</h3>
            <p class="m-0 text-sm text-white/70">{{ p.location }} · {{ p.objectType }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
