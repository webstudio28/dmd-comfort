---
layout: base.njk
permalink: /uslugi/
title: Услуги
description: Дограма, врати, плъзгащи системи, щори, душ кабини и метални конструкции от ДМД Комфорт.
pageImage: /assets/images/services/pvc-dograma.webp
pageImageWidth: 1600
pageImageHeight: 900
pageImageAlt: Услуги на ДМД Комфорт - дограма, врати и остъкляване
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/service-image.njk" import serviceImage %}

{% call pageBanner() %}
  <div class="eyebrow text-brand before:bg-brand">Каталог услуги</div>
  <h1 class="mt-3 max-w-3xl font-display text-[clamp(2.5rem,5vw,3.75rem)] font-black leading-none">Всички услуги</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/70">Дограма, врати, плъзгащи системи, щори и метални конструкции.</p>
{% endcall %}

{{ breadcrumbs([
  { label: "Начало", url: "/" },
  { label: "Услуги" }
]) }}

<section class="section-pad bg-brand-mist">
  <div class="container-site grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {% for s in catalogServices %}
      <article class="card reveal flex flex-col">
        <div class="relative m-3 aspect-[4/3] overflow-hidden rounded-lg bg-brand-mist">
          {{ serviceImage(s, "h-full w-full") }}
        </div>
        <div class="flex flex-1 flex-col border-t border-ink/10 px-5 pb-6 pt-4">
          <h2 class="mb-2 font-display text-[22px] font-extrabold">{{ s.title }}</h2>
          {% if s.shortDescription %}
            <p class="mb-4 text-[15px] leading-relaxed text-ink-muted">{{ s.shortDescription }}</p>
          {% endif %}
          {% if s.menuChildren and s.menuChildren.length %}
            <p class="mb-5 flex-1 text-[15px] leading-relaxed text-ink-muted">
              {% for child in s.menuChildren %}<a class="text-ink underline underline-offset-4 decoration-ink/20 hover:text-brand" href="{{ ('/uslugi/' + child.slug + '/') | url }}">{{ child.title }}</a>{% if not loop.last %}<span aria-hidden="true"> · </span>{% endif %}{% endfor %}
            </p>
          {% else %}
            <div class="mb-5 flex-1"></div>
          {% endif %}
          <a class="arrow-link" href="{{ (s.href or ('/uslugi/' + s.slug + '/')) | url }}">Разгледай
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
