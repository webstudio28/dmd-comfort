---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/uslugi/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.title }}"
  description: "{{ service.shortDescription }}"
---
{% from "macros/page-banner.njk" import pageBanner %}

{% call pageBanner() %}
  <div class="grid items-end gap-8 lg:grid-cols-2">
    <div>
      <a class="text-sm text-white/50 no-underline hover:text-brand" href="{{ '/uslugi/' | url }}">← Всички услуги</a>
      <h1 class="mt-4 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] font-black leading-none">{{ service.title }}</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">{{ service.shortDescription }}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="btn btn-primary open-inquiry" type="button">Заяви оглед</button>
        {% if service.relatedPage %}
          <a class="btn btn-light" href="{{ service.relatedPage | url }}">Повече за обръщането</a>
        {% endif %}
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-white/10 shadow-lift">
      <img class="aspect-[4/3] w-full object-cover" src="{{ service.image }}" alt="{{ service.title }}" />
    </div>
  </div>
{% endcall %}

<section class="section-pad bg-white">
  <div class="container-site reveal">
    <div class="eyebrow">Описание</div>
    <h2 class="section-title">Повече за услугата</h2>
    <p class="max-w-none text-[17px] leading-relaxed text-ink-muted md:text-lg">{{ service.longDescription }}</p>
  </div>
</section>

<section class="section-pad bg-brand-mist">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal">
      <div class="eyebrow">Какво получавате</div>
      <h2 class="section-title">Какво включва</h2>
      <p class="section-copy">Пълен пакет — от първия оглед до финалния реглаж.</p>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {% for item in service.includes %}
        <li class="reveal flex gap-3 rounded-2xl border border-ink/10 bg-white px-5 py-5 text-ink shadow-card">
          <span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand text-sm font-bold text-white">✓</span>
          <span class="font-display text-lg font-bold leading-snug">{{ item }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal">
      <div class="eyebrow">Стъпки</div>
      <h2 class="section-title">Как протича процесът</h2>
      <p class="section-copy">Ясен ред на работа без изненади по пътя.</p>
    </div>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {% for step in service.process %}
        <li class="reveal relative rounded-2xl border border-ink/10 bg-brand-mist p-6">
          <span class="mb-4 inline-flex font-display text-4xl font-black text-brand/20">0{{ loop.index }}</span>
          <div class="font-display text-xl font-extrabold leading-snug">{{ step }}</div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section-pad bg-brand-mist">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal">
      <div class="eyebrow">Детайли</div>
      <h2 class="section-title">Важно за избора</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      <div class="reveal rounded-2xl border border-ink/10 bg-white p-7 shadow-card">
        <h3 class="font-display text-xl font-extrabold">Предимства</h3>
        <ul class="mt-5 space-y-3">
          {% for a in service.advantages %}
            <li class="flex gap-3 text-[15px] leading-relaxed text-ink-muted">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
              {{ a }}
            </li>
          {% endfor %}
        </ul>
      </div>
      <div class="reveal rounded-2xl border border-ink/10 bg-white p-7 shadow-card">
        <h3 class="font-display text-xl font-extrabold">Подходящо за</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">{{ service.suitableFor | join(" · ") }}</p>
        <h3 class="mt-8 font-display text-xl font-extrabold">Материали</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">{{ service.materials }}</p>
      </div>
      <div class="reveal rounded-2xl border border-ink/10 bg-white p-7 shadow-card">
        <h3 class="font-display text-xl font-extrabold">Варианти и опции</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">{{ service.options }}</p>
      </div>
      <div class="reveal rounded-2xl border border-ink/10 bg-white p-7 shadow-card">
        <h3 class="font-display text-xl font-extrabold">Гаранция</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-ink-muted">{{ service.warranty }}</p>
        <button class="btn btn-primary mt-8 open-inquiry" type="button">Заяви оглед</button>
      </div>
    </div>
  </div>
</section>

{% if service.faq and service.faq.length %}
<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Често задавани въпроси</h2>
    </div>
    <div class="space-y-4">
      {% for f in service.faq %}
        <details class="reveal overflow-hidden rounded-2xl border border-ink/10 bg-brand-mist open:bg-white open:shadow-card">
          <summary class="cursor-pointer list-none px-6 py-5 font-display text-lg font-extrabold marker:content-none">{{ f.q }}</summary>
          <div class="border-t border-ink/10 px-6 py-5 text-[15px] leading-relaxed text-ink-muted">{{ f.a }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "sections/home-cta.njk" %}
