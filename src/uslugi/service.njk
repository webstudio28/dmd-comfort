---
layout: base.njk
bodyClass: window-finishing service-detail
pageStyles: /assets/css/service-detail.css
inquiryEyebrow: Индивидуална оферта
pagination:
  data: serviceDetails
  size: 1
  alias: service
permalink: "/uslugi/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.copy.seoTitle }}"
  description: "{{ service.copy.description }}"
  pageImage: "{{ service.image if service.image and not service.imageMissing else '' }}"
  inquiryDescription: "{{ service.copy.inquiry }}"
  inquiryPlaceholder: "{{ service.copy.inquiry }}"
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}
{% from "macros/faq-schema.njk" import faqSchema %}
{% macro arrow() %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}
{% macro check() %}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endmacro %}
{% macro rail(items, label, ordered=false, actionLabel='Разгледайте услугата') %}
  {% if ordered %}<ol{% else %}<ul{% endif %} class="trim-process trim-process--five trim-service-rail" data-service-carousel data-card-count="{{ items.length }}" tabindex="0" role="region" aria-label="{{ label }} — плъзнете хоризонтално">
    {% for item in items %}
    <li{% if not item.url %} data-step="0{{ loop.index }}"{% else %} class="trim-service-link-slide"{% endif %}>
      {% if item.url %}<a class="trim-service-card-link" href="{{ item.url | url }}" draggable="false">
        {% if item.image and not item.imageMissing %}<img src="{{ item.image | url }}" alt="{{ item.imageAlt or item.title }}" width="{{ item.imageWidth or 640 }}" height="{{ item.imageHeight or 480 }}"{% if item.imageFit == "contain" %} style="object-fit: contain; background: #edf1ed"{% endif %} loading="lazy" decoding="async" draggable="false" />{% endif %}
        <div class="trim-service-card-body">
      {% endif %}
      <h3>{{ item.title }}</h3><p>{{ item.text or item.summary }}</p>
      {% if item.url %}<span class="trim-service-card-action">{{ actionLabel }} {{ arrow() }}</span></div></a>{% endif %}
    </li>
    {% endfor %}
  {% if ordered %}</ol>{% else %}</ul>{% endif %}
{% endmacro %}
{% macro faqItem(faq) %}
<details class="trim-faq-item">
  <summary class="trim-faq-summary"><span>{{ faq.q }}</span><span class="trim-faq-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></summary>
  <div class="trim-faq-answer"><div class="trim-faq-answer-inner"><div class="trim-faq-answer-body"><p>{{ faq.a }}</p></div></div></div>
</details>
{% endmacro %}

{% call pageBanner() %}
  <div class="grid items-end gap-8{% if service.image and not service.imageMissing %} lg:grid-cols-2{% endif %}">
    <div>
      <h1 class="font-display text-[clamp(2.25rem,4.5vw,3.5rem)] font-black leading-none" id="trim-title">{{ service.copy.h1 }}</h1>
      <p class="mt-4 text-lg leading-relaxed text-white/70{% if service.image and not service.imageMissing %} max-w-xl{% endif %}">{{ service.copy.description }}</p>
      <div class="mt-6 flex flex-wrap items-center gap-5"><button class="btn btn-primary open-inquiry" type="button">Поискайте оферта {{ arrow() }}</button><a class="trim-text-link trim-text-link-light" href="#montazh">Вижте как се изпълнява <span aria-hidden="true">↓</span></a></div>
    </div>
    {% if service.image and not service.imageMissing %}
    <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-lift"><img class="aspect-[4/3] w-full object-cover" src="{{ service.image | url }}" alt="{{ service.imageAlt or service.title }}" width="{{ service.imageWidth or 1536 }}" height="{{ service.imageHeight or 1024 }}"{% if service.imageFit == "contain" %} style="object-fit: contain"{% endif %} fetchpriority="high" decoding="async" /><div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 to-transparent" aria-hidden="true"></div></div>
    {% endif %}
  </div>
{% endcall %}
<div class="trim-benefits trim-band--mist"><div class="container-site trim-benefits-grid">{% for feature in service.copy.features %}{% if loop.index0 < 3 %}<div>{{ check() }}<span>{{ feature.title }}</span></div>{% endif %}{% endfor %}</div></div>
{% if service.parentUrl %}
{{ breadcrumbs([{label: "Начало", url: "/"}, {label: "Услуги", url: "/uslugi/"}, {label: service.parentTitle, url: service.parentUrl}, {label: service.title}]) }}
{% else %}
{{ breadcrumbs([{label: "Начало", url: "/"}, {label: "Услуги", url: "/uslugi/"}, {label: service.title}]) }}
{% endif %}

{% set band = cycler("trim-band--white", "trim-band--mist", "trim-band--lined", "trim-band--mist") %}
<section class="trim-section {{ band.next() }}" aria-labelledby="trim-intro-title"><div class="container-site"><h2 class="trim-heading" id="trim-intro-title">{{ service.copy.introTitle }}</h2><div class="trim-prose">{% for paragraph in service.copy.intro %}<p>{{ paragraph }}</p>{% endfor %}</div></div></section>

{% if service.relatedProjects.length %}
<section class="trim-section {{ band.next() }}" aria-labelledby="trim-projects-title">
  <div class="container-site">
    <div class="trim-section-head trim-projects-head">
      <div>
        <h2 class="trim-heading" id="trim-projects-title">Нашите проекти за {{ service.title }}</h2>
        <p>Реализирани обекти, свързани с тази услуга.</p>
      </div>
      {% if service.projectsMoreUrl %}
      <a class="trim-text-link" href="{{ service.projectsMoreUrl | url }}">Всички проекти{% if service.projectsTotal > service.relatedProjects.length %} ({{ service.projectsTotal }}){% endif %} {{ arrow() }}</a>
      {% endif %}
    </div>
  </div>
  {{ rail(service.relatedProjects, 'Нашите проекти', false, 'Разгледайте проекта') }}
</section>
{% endif %}

<section class="trim-section {{ band.next() }}" aria-labelledby="trim-features-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-features-title">Какво съобразяваме с вашия обект?</h2></div></div>{{ rail(service.copy.features, 'Основни детайли') }}</section>

{% if service.subcategoryCards.length %}
<section class="trim-section {{ band.next() }}" aria-labelledby="trim-types-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-types-title">{{ service.copy.typesTitle }}</h2></div></div>{{ rail(service.subcategoryCards, 'Видове услуги') }}</section>
{% endif %}

<section class="trim-section {{ band.next() }}" aria-labelledby="trim-suitable-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-suitable-title">Кога е подходящо това решение?</h2></div></div>{{ rail(service.copy.applications, 'Приложения') }}</section>

<section class="trim-section {{ band.next() }}" id="materiali" aria-labelledby="trim-materials-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-materials-title">Материали, размери и детайли на изпълнението</h2></div></div>{{ rail(service.copy.materials, 'Материали и детайли') }}</section>

{% for section in service.copy.sections %}
<section class="trim-section {{ band.next() }}" aria-labelledby="trim-detail-{{ loop.index }}"><div class="container-site"><h2 class="trim-heading" id="trim-detail-{{ loop.index }}">{{ section.title }}</h2><div class="trim-prose">{% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}</div></div></section>
{% endfor %}

<section class="trim-section {{ band.next() }}" id="montazh" aria-labelledby="trim-process-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-process-title">Как протича работата?</h2></div></div>{{ rail(service.copy.process, 'Как протича работата', true) }}</section>

<section class="trim-section trim-price-section {{ band.next() }}" id="tsena" aria-labelledby="trim-price-title">
  <div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-price-title">Как се определя цената?</h2></div><p class="trim-copy trim-service-price-intro">{{ service.copy.priceText }}</p></div>
  {{ rail(service.copy.priceDetails, 'Фактори за цената') }}
  <div class="container-site"><aside class="trim-quote-card" aria-labelledby="trim-quote-title"><h3 id="trim-quote-title">Оферта според вашия обект</h3><p>{{ service.copy.inquiry }}</p><button class="btn btn-primary open-inquiry mt-6" type="button">Поискайте оферта за вашия обект {{ arrow() }}</button></aside></div>
</section>

{% if service.relatedServices.length %}
<section class="trim-section trim-comparison-section {{ band.next() }}" aria-labelledby="trim-related-title"><div class="container-site"><div class="trim-section-head"><h2 class="trim-heading" id="trim-related-title">{{ service.copy.relatedTitle }}</h2></div></div>{{ rail(service.relatedServices, 'Свързани услуги') }}</section>
{% endif %}

<section class="trim-section {{ band.next() }}" id="vaprosi" aria-labelledby="trim-faq-title" data-faq>
  <div class="container-site"><div class="trim-faq-head"><h2 class="trim-heading" id="trim-faq-title">Често задавани въпроси</h2><p>Отговори за избора, подготовката и изпълнението на услугата.</p></div>
    <div class="trim-faq-list"><div class="trim-faq-stack">{% for faq in service.copy.faq %}{% if loop.index0 < 7 %}{{ faqItem(faq) }}{% endif %}{% endfor %}</div>
      {% if service.copy.faq.length > 7 %}
      <div class="trim-faq-extra" data-faq-extra><div class="trim-faq-extra-inner trim-faq-stack" data-faq-extra-inner>{% for faq in service.copy.faq %}{% if loop.index0 >= 7 %}{{ faqItem(faq) }}{% endif %}{% endfor %}</div><div class="trim-faq-extra-fade" aria-hidden="true"></div></div>
      <div class="trim-faq-more-wrap"><button class="trim-faq-more" type="button" data-faq-expand aria-expanded="false" data-label-more="Вижте още" data-label-less="Вижте по-малко"><span data-faq-expand-label>Вижте още</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></button></div>
      {% endif %}
    </div>
  </div>
</section>

<section class="trim-contact" id="zapitvane" aria-labelledby="trim-contact-title"><div class="container-site trim-contact-grid"><div><h2 id="trim-contact-title">{{ service.copy.ctaTitle }}</h2><p>{{ service.copy.ctaText }}</p></div><div class="trim-contact-actions"><button class="btn btn-primary open-inquiry" type="button">Поискайте оферта {{ arrow() }}</button></div></div></section>

{{ faqSchema(service.copy.faq) }}
{% set serviceUrl = site.seo.siteUrl + (page.url | url) %}
<script type="application/ld+json">
{"@context":"https://schema.org","@graph":[
 {"@type":"Service","@id":{{ (serviceUrl + '#service') | dump | safe }},"name":{{ service.copy.h1 | dump | safe }},"serviceType":{{ service.title | dump | safe }},"description":{{ service.copy.description | dump | safe }},"url":{{ serviceUrl | dump | safe }},"provider":{"@id":{{ (site.seo.siteUrl + '/#organization') | dump | safe }}},"areaServed":[{"@type":"City","name":"Пловдив"},{"@type":"Country","name":"България"}]},
 {"@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Начало","item":{{ (site.seo.siteUrl + ('/' | url)) | dump | safe }}},
  {"@type":"ListItem","position":2,"name":"Услуги","item":{{ (site.seo.siteUrl + ('/uslugi/' | url)) | dump | safe }}},
  {% if service.parentUrl %}{"@type":"ListItem","position":3,"name":{{ service.parentTitle | dump | safe }},"item":{{ (site.seo.siteUrl + (service.parentUrl | url)) | dump | safe }}},{% endif %}
  {"@type":"ListItem","position":{% if service.parentUrl %}4{% else %}3{% endif %},"name":{{ service.title | dump | safe }},"item":{{ serviceUrl | dump | safe }}}
 ]}
]}
</script>
<script src="{{ '/assets/js/service-carousel.js' | url }}" defer></script>
