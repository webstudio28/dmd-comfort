---
layout: base.njk
pagination:
  data: services
  size: 1
  alias: service
permalink: "/uslugi/{{ service.slug }}/"
eleventyComputed:
  title: "{{ service.title }}"
  description: "{{ service.shortDescription }}"
---

<section class="bg-gradient-to-br from-brand-deeper via-ink to-brand-dark pb-16 pt-32 text-white">
  <div class="container-site grid items-end gap-8 lg:grid-cols-2">
    <div>
      <a class="text-sm text-white/50 no-underline hover:text-brand" href="{{ '/uslugi/' | url }}">← Всички услуги</a>
      <h1 class="mt-4 font-display text-[clamp(2.5rem,5vw,4rem)] font-black leading-none">{{ service.title }}</h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/70">{{ service.shortDescription }}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <button class="btn btn-primary open-inquiry" type="button">Заяви оглед</button>
        {% if service.relatedPage %}
          <a class="btn btn-light" href="{{ service.relatedPage | url }}">Повече за обръщането</a>
        {% endif %}
      </div>
    </div>
    <div class="overflow-hidden rounded-2xl border border-white/10 shadow-lift">
      <img class="aspect-[4/3] w-full object-cover" src="{{ service.image }}" alt="{{ service.title }}" />
    </div>
  </div>
</section>

<section class="section-pad bg-white">
  <div class="container-site grid gap-10 lg:grid-cols-3">
    <div class="lg:col-span-2 reveal">
      <div class="eyebrow">Описание</div>
      <h2 class="section-title">Повече за услугата</h2>
      <p class="text-[17px] leading-relaxed text-ink-muted">{{ service.longDescription }}</p>

      <h3 class="mt-10 mb-4 font-display text-2xl font-extrabold">Какво включва</h3>
      <ul class="grid gap-3 sm:grid-cols-2">
        {% for item in service.includes %}
          <li class="flex gap-3 rounded-xl bg-brand-mist px-4 py-3 text-ink">
            <span class="text-brand">✓</span>{{ item }}
          </li>
        {% endfor %}
      </ul>

      <h3 class="mt-10 mb-4 font-display text-2xl font-extrabold">Как протича процесът</h3>
      <ol class="grid gap-3 sm:grid-cols-2">
        {% for step in service.process %}
          <li class="rounded-xl border border-ink/10 px-4 py-3">
            <span class="font-display text-sm font-bold text-brand">0{{ loop.index }}</span>
            <div class="mt-1 font-medium">{{ step }}</div>
          </li>
        {% endfor %}
      </ol>
    </div>

    <aside class="space-y-4 reveal">
      <div class="rounded-2xl border border-ink/10 bg-brand-mist p-6">
        <h3 class="font-display text-lg font-extrabold">Предимства</h3>
        <ul class="mt-3 space-y-2 text-sm text-ink-muted">
          {% for a in service.advantages %}
            <li>• {{ a }}</li>
          {% endfor %}
        </ul>
      </div>
      <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-card">
        <h3 class="font-display text-lg font-extrabold">Подходящо за</h3>
        <p class="mt-2 text-sm text-ink-muted">{{ service.suitableFor | join(", ") }}</p>
        <h3 class="mt-5 font-display text-lg font-extrabold">Материали</h3>
        <p class="mt-2 text-sm text-ink-muted">{{ service.materials }}</p>
        <h3 class="mt-5 font-display text-lg font-extrabold">Варианти</h3>
        <p class="mt-2 text-sm text-ink-muted">{{ service.options }}</p>
        <h3 class="mt-5 font-display text-lg font-extrabold">Гаранция</h3>
        <p class="mt-2 text-sm text-ink-muted">{{ service.warranty }}</p>
      </div>
    </aside>
  </div>
</section>

{% if service.faq and service.faq.length %}
<section class="section-pad bg-brand-mist">
  <div class="container-site">
    <div class="mb-8 reveal">
      <div class="eyebrow">FAQ</div>
      <h2 class="section-title">Често задавани въпроси</h2>
    </div>
    <div class="mx-auto max-w-3xl space-y-3">
      {% for f in service.faq %}
        <details class="card reveal">
          <summary class="cursor-pointer list-none px-5 py-4 font-display text-lg font-extrabold">{{ f.q }}</summary>
          <div class="border-t border-ink/10 px-5 py-4 text-ink-muted leading-relaxed">{{ f.a }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% include "sections/home-cta.njk" %}
