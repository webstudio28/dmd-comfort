---
layout: base.njk
bodyClass: blog-article
pageStyles: /assets/css/blog-article.css
inquiryEyebrow: Индивидуална оферта
pagination:
  data: blog
  size: 1
  alias: article
permalink: "/blog/{{ article.slug }}/"
eleventyComputed:
  title: "{{ article.seoTitle or article.title }}"
  description: "{{ article.excerpt }}"
  pageImage: "{{ article.image }}"
  inquiryHref: "{{ article.cta.url or '/obrashtane-na-dograma-s-pvc-profili/' }}"
  inquiryDescription: "{{ article.cta.text or 'Посочете населеното място, броя прозорци или врати и състоянието около дограмата.' }}"
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}

<article>
  {% call pageBanner() %}
    <div class="flex flex-wrap gap-3 text-xs font-bold uppercase tracking-[0.14em] text-[#a5d7b8]">
      <span>{{ article.category }}</span>
      <time class="text-white/60" datetime="{{ article.date }}">{{ article.displayDate }}</time>
    </div>
    <h1 class="blog-article-title mt-3 font-display font-black">{{ article.title }}</h1>
    <p class="blog-article-excerpt mt-4 text-lg leading-relaxed text-white/70">{{ article.excerpt }}</p>
  {% endcall %}

  {{ breadcrumbs([
    { label: "Начало", url: "/" },
    { label: "Блог", url: "/blog/" },
    { label: article.title }
  ]) }}

  <div class="section-pad bg-white">
    <div class="container-site blog-article-content">
      <figure class="blog-article-figure{% if article.imageFit == 'contain' %} blog-article-figure--contain{% endif %}">
        <img src="{{ article.image | url }}" alt="{{ article.imageAlt }}" width="{{ article.imageWidth or 1536 }}" height="{{ article.imageHeight or 1024 }}" fetchpriority="high" decoding="async" />
        {% if article.imageCredit %}<figcaption><a href="{{ article.imageCredit.url }}">{{ article.imageCredit.text }}</a></figcaption>{% endif %}
      </figure>

      <div class="blog-article-intro">
        {% for paragraph in article.intro %}<p>{{ paragraph }}</p>{% endfor %}
      </div>

      <nav class="blog-toc" aria-labelledby="article-toc-title">
        <h2 id="article-toc-title">В тази статия</h2>
        <ol>
          {% for section in article.sections %}<li><a href="#{{ section.id }}">{{ section.title }}</a></li>{% endfor %}
          <li><a href="#chesto-zadavani-vaprosi">Често задавани въпроси</a></li>
        </ol>
      </nav>

      {% for section in article.sections %}
        <section class="blog-section" id="{{ section.id }}" aria-labelledby="heading-{{ section.id }}">
          <h2 id="heading-{{ section.id }}">{{ section.title }}</h2>
          {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
          {% if section.bullets %}<ul class="blog-bullet-list">{% for bullet in section.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
          {% if section.table %}
            <div class="blog-comparison-wrap" role="region" aria-label="{{ section.table.caption or 'Сравнение на методите за обръщане на прозорци' }}" tabindex="0">
              <table class="blog-comparison">
                <caption>{{ section.table.caption or 'Основни разлики между стандартно обръщане и PVC профили' }}</caption>
                <thead><tr>{% for header in section.table.headers %}<th scope="col">{{ header }}</th>{% endfor %}</tr></thead>
                <tbody>{% for row in section.table.rows %}<tr>{% for cell in row %}{% if loop.first %}<th scope="row">{{ cell }}</th>{% else %}<td>{{ cell }}</td>{% endif %}{% endfor %}</tr>{% endfor %}</tbody>
              </table>
            </div>
          {% endif %}
          {% for subsection in section.subsections %}
            <h3>{{ subsection.title }}</h3>
            {% for paragraph in subsection.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
          {% endfor %}
          {% if section.image %}<figure class="blog-detail-image"><img src="{{ section.image.url | url }}" alt="{{ section.image.alt }}" width="{{ section.image.width }}" height="{{ section.image.height }}" loading="lazy" decoding="async" /></figure>{% endif %}
          {% if section.closing %}<p>{{ section.closing }}</p>{% endif %}
          {% if section.serviceLink %}<p class="blog-service-link"><a href="{{ section.serviceLink.url | url }}">{{ section.serviceLink.text }} <span aria-hidden="true">→</span></a></p>{% endif %}
        </section>
      {% endfor %}

      <section class="blog-section" id="chesto-zadavani-vaprosi" aria-labelledby="article-faq-title">
        <h2 id="article-faq-title">Често задавани въпроси</h2>
        {% for faq in article.faqs %}
          <details class="blog-faq"><summary>{{ faq.q }}</summary><p>{{ faq.a }}</p></details>
        {% endfor %}
      </section>

      <aside class="blog-article-cta" aria-labelledby="article-cta-title">
        <p class="blog-article-eyebrow">ДМД Комфорт · Пловдив и страната</p>
        <h2 id="article-cta-title">{{ article.cta.title or 'Обсъдете обръщането на вашите прозорци' }}</h2>
        <p>{{ article.cta.text or 'Разгледайте как изпълняваме вътрешно обръщане с PVC профили и какво е необходимо за оферта. Приемаме запитвания за прозорци и врати в Пловдив и региона, както и за обекти в други населени места в България.' }}</p>
        <div class="blog-cta-actions">
          <a class="btn btn-primary" href="{{ (article.cta.url or '/obrashtane-na-dograma-s-pvc-profili/') | url }}">{{ article.cta.label or 'Вижте услугата с PVC профили' }} <span aria-hidden="true">→</span></a>
          <button class="btn blog-contact-button open-inquiry" type="button" aria-haspopup="dialog">Изпратете запитване</button>
        </div>
      </aside>

      {% if article.relatedSlugs and article.relatedSlugs.length %}
      <section class="blog-related" aria-labelledby="blog-related-title">
        <h2 id="blog-related-title">Прочетете още</h2>
      </section>
      {% endif %}
    </div>
    {% if article.relatedSlugs and article.relatedSlugs.length %}
    <div
      class="blog-related-rail"
      data-drag-scroll
      data-card-count="{{ article.relatedSlugs.length }}"
      tabindex="0"
      role="region"
      aria-label="Прочетете още - плъзнете хоризонтално"
    >
      {% for slug in article.relatedSlugs %}
        {% for related in blog %}
          {% if related.slug == slug %}
          <a class="blog-related-card" href="{{ ('/blog/' + related.slug + '/') | url }}" draggable="false">
            <img src="{{ related.image | url }}" alt="{{ related.imageAlt or related.title }}" loading="lazy" decoding="async" width="{{ related.imageWidth or 1536 }}" height="{{ related.imageHeight or 1024 }}" draggable="false" />
            <h3>{{ related.title }}</h3>
            <p>{{ related.excerpt }}</p>
          </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    {% endif %}
    <div class="container-site">
      <a class="blog-back-link" href="{{ '/blog/' | url }}"><span aria-hidden="true">←</span> Обратно към блога</a>
    </div>
  </div>
</article>

{% set articleUrl = site.seo.siteUrl + (page.url | url) %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": {{ (articleUrl + '#article') | dump | safe }},
      "headline": {{ article.title | dump | safe }},
      "description": {{ article.excerpt | dump | safe }},
      "datePublished": {{ article.date | dump | safe }},
      "dateModified": {{ article.date | dump | safe }},
      "inLanguage": "bg-BG",
      "image": {{ (site.seo.siteUrl + (article.image | url)) | dump | safe }},
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ articleUrl | dump | safe }} },
      "author": { "@type": "Organization", "name": {{ site.brand.name | dump | safe }}, "url": {{ site.seo.siteUrl | dump | safe }} },
      "publisher": { "@type": "Organization", "name": {{ site.brand.name | dump | safe }}, "url": {{ site.seo.siteUrl | dump | safe }} }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Начало", "item": {{ (site.seo.siteUrl + ('/' | url)) | dump | safe }} },
        { "@type": "ListItem", "position": 2, "name": "Блог", "item": {{ (site.seo.siteUrl + ('/blog/' | url)) | dump | safe }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | dump | safe }}, "item": {{ articleUrl | dump | safe }} }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {% for faq in article.faqs %}
          { "@type": "Question", "name": {{ faq.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ faq.a | dump | safe }} } }{% if not loop.last %},{% endif %}
        {% endfor %}
      ]
    }
  ]
}
</script>
