# DMD Comfort - LiteSpeed / Apache

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Apex host (no www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Legacy .com host -> .bg
  RewriteCond %{HTTP_HOST} ^(www\.)?dmdkomfort\.com$ [NC]
  RewriteRule ^ https://dmdkomfort.bg%{REQUEST_URI} [L,R=301]

  # Short obrashtane URL -> canonical page
  RewriteRule ^obrashtane-na-dograma/?$ /obrashtane-na-dograma-s-pvc-profili/ [L,R=301]

  # Renamed project: Неозаглавен -> Смесени изпълнения
  RewriteRule ^proekti/neozaglaven/?$ /proekti/smeseni-izpalneniya/ [L,R=301]

  # Block public access to form logs
  RewriteRule ^private(/|$) - [F,L]
</IfModule>

# Extra lock on private logs (Apache/LiteSpeed)
<IfModule mod_authz_core.c>
  <DirectoryMatch ".*/private">
    Require all denied
  </DirectoryMatch>
</IfModule>

# Caching + charset for plain text
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|gif|svg|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "(llms|robots)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
  </FilesMatch>
</IfModule>
