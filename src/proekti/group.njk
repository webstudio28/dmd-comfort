---
layout: base.njk
pagination:
  data: projectGroups
  size: 1
  alias: group
permalink: "{{ group.href }}"
eleventyComputed:
  title: "Проекти — {{ group.title }}"
  description: "{% if group.slug == 'drugi' %}Други реализирани обекти на ДМД Комфорт.{% else %}Реализирани проекти за {{ group.title }} от ДМД Комфорт.{% endif %}"
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}

{% call pageBanner() %}
  <div class="eyebrow text-brand before:bg-brand">Проекти</div>
  <h1 class="mt-3 max-w-3xl font-display text-[clamp(2.5rem,5vw,3.75rem)] font-black leading-none">{{ group.title }}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/70">{{ group.countLabel }} от нашата работа.</p>
{% endcall %}

{{ breadcrumbs([
  { label: "Начало", url: "/" },
  { label: "Проекти", url: "/proekti/" },
  { label: group.title }
]) }}

<section class="section-pad bg-brand-mist">
  <div class="container-site grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {% for p in group.projects %}
      <a class="card reveal group block no-underline" href="{{ ('/proekti/' + p.slug + '/') | url }}">
        <div class="relative m-3 aspect-[4/3] overflow-hidden rounded-lg">
          <img class="image-cover" src="{{ p.images[0] | url }}" alt="{{ p.title }}" loading="lazy" />
        </div>
        <div class="border-t border-ink/10 px-5 pb-6 pt-4">
          <h2 class="mb-2 line-clamp-3 font-display text-xl font-extrabold text-ink group-hover:text-brand">{{ p.title }}</h2>
          <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{{ p.shortDescription }}</p>
        </div>
      </a>
    {% endfor %}
  </div>
</section>
