---
layout: base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/proekti/{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.shortDescription }}"
---
{% from "macros/page-banner.njk" import pageBanner %}

{% call pageBanner() %}
  <div class="grid items-end gap-8 lg:grid-cols-2">
    <div>
      <a class="text-sm text-white/50 no-underline hover:text-brand" href="{{ '/proekti/' | url }}">← Всички проекти</a>
      <div class="mt-4 text-sm font-bold uppercase tracking-[0.14em] text-brand">{{ project.location }} · {{ project.objectType }}</div>
      <h1 class="mt-3 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] font-black leading-none">{{ project.title }}</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">{{ project.shortDescription }}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="btn btn-primary open-inquiry" type="button">Заяви подобен проект</button>
      </div>
    </div>
    {% if project.images and project.images.length %}
      <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-lift">
        <img class="aspect-[4/3] w-full object-cover" src="{{ project.images[0] | url }}" alt="{{ project.title }}" />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 to-transparent" aria-hidden="true"></div>
      </div>
    {% endif %}
  </div>
{% endcall %}

{% if project.images and project.images.length %}
<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal md:mb-12">
      <div class="eyebrow">Галерия</div>
      <h2 class="section-title">Снимки от обекта</h2>
      <p class="section-copy">Реални кадри от изпълнението и крайния резултат.</p>
    </div>
    <div class="h-scroll reveal md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-4">
      {% for img in project.images %}
        <figure class="overflow-hidden rounded-xl bg-brand-mist shadow-card">
          <img
            class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-[1.03]"
            src="{{ img | url }}"
            alt="{{ project.title }} — снимка {{ loop.index }}"
            loading="lazy"
            decoding="async"
          />
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if project.videos and project.videos.length %}
<section class="section-pad bg-brand-mist">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal md:mb-12">
      <div class="eyebrow">Видео</div>
      <h2 class="section-title">От обекта</h2>
      <p class="section-copy">Гледайте как протича работата и какъв е крайният резултат.</p>
    </div>
    <div class="grid gap-6 {% if project.videos.length > 1 %}md:grid-cols-2{% else %}max-w-4xl{% endif %}">
      {% for video in project.videos %}
        <article class="reveal overflow-hidden rounded-2xl bg-[#1a1d1f] shadow-lift">
          <div class="aspect-video overflow-hidden bg-black">
            <iframe
              class="h-full w-full"
              src="{% if 'watch?v=' in video.url %}{{ video.url | replace('https://www.youtube.com/watch?v=', 'https://www.youtube.com/embed/') | replace('http://www.youtube.com/watch?v=', 'https://www.youtube.com/embed/') }}{% elif 'youtu.be/' in video.url %}{{ video.url | replace('https://youtu.be/', 'https://www.youtube.com/embed/') | replace('http://youtu.be/', 'https://www.youtube.com/embed/') }}{% else %}{{ video.url }}{% endif %}"
              title="{{ video.title or project.title }}"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          {% if video.title %}
            <div class="px-5 py-4">
              <h3 class="font-display text-lg font-extrabold text-white">{{ video.title }}</h3>
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section class="relative section-pad overflow-hidden bg-white">
  <div class="pointer-events-none absolute -right-20 top-10 h-64 w-64 rounded-full bg-brand/5 blur-3xl" aria-hidden="true"></div>
  <div class="container-site relative reveal">
    <div class="grid gap-10 lg:grid-cols-[auto_1fr] lg:gap-14">
      <div class="hidden w-px bg-gradient-to-b from-brand via-brand/40 to-transparent lg:block" aria-hidden="true"></div>
      <div>
        <div class="eyebrow">Описание</div>
        <h2 class="section-title">За проекта</h2>
        <p class="border-l-4 border-brand pl-6 text-[17px] leading-relaxed text-ink-muted md:text-lg md:leading-8">{{ project.description }}</p>
      </div>
    </div>
  </div>
</section>

<section class="relative overflow-hidden section-pad text-white">
  <div class="absolute inset-0 bg-gradient-to-br from-[#1a1d1f] via-[#161a1c] to-[#121516]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_80%_40%,rgba(5,114,48,0.18),transparent_55%)]" aria-hidden="true"></div>
  <div class="container-site relative z-10">
    <div class="mb-12 max-w-2xl reveal">
      <div class="eyebrow text-brand before:bg-brand">Детайли</div>
      <h2 class="section-title text-white">Какво свършихме</h2>
      <p class="section-copy text-white/60">Заданието, материалите и резултатът — накратко.</p>
    </div>
    <div class="grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 md:grid-cols-2">
      <div class="reveal bg-white/[0.04] p-8 md:p-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
          <h3 class="font-display text-xl font-extrabold md:text-2xl">Задание</h3>
        </div>
        <p class="text-[15px] leading-relaxed text-white/65">{{ project.assignment }}</p>
      </div>
      <div class="reveal bg-white/[0.04] p-8 md:p-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
          <h3 class="font-display text-xl font-extrabold md:text-2xl">Изпълнени услуги</h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {% for s in project.servicesDone %}
            <span class="rounded-lg border border-white/15 bg-white/5 px-3.5 py-2 font-display text-sm font-bold text-white">{{ s }}</span>
          {% endfor %}
        </div>
      </div>
      <div class="reveal bg-white/[0.04] p-8 md:p-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
          <h3 class="font-display text-xl font-extrabold md:text-2xl">Монтирано</h3>
        </div>
        <p class="text-[15px] leading-relaxed text-white/65">{{ project.installed }}</p>
      </div>
      <div class="reveal bg-white/[0.04] p-8 md:p-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
          <h3 class="font-display text-xl font-extrabold md:text-2xl">Материали</h3>
        </div>
        <p class="text-[15px] leading-relaxed text-white/65">{{ project.materials }}</p>
      </div>
      <div class="reveal bg-white/[0.04] p-8 md:p-10">
        <div class="mb-4 flex items-center gap-3">
          <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
          <h3 class="font-display text-xl font-extrabold md:text-2xl">Трудности</h3>
        </div>
        <p class="text-[15px] leading-relaxed text-white/65">{{ project.challenges }}</p>
      </div>
      <div class="reveal relative overflow-hidden bg-brand/20 p-8 md:p-10">
        <div class="pointer-events-none absolute -right-8 -top-8 h-40 w-40 rounded-full bg-brand/30 blur-2xl" aria-hidden="true"></div>
        <div class="relative">
          <div class="mb-4 flex items-center gap-3">
            <span class="h-8 w-1 rounded-full bg-brand" aria-hidden="true"></span>
            <h3 class="font-display text-xl font-extrabold md:text-2xl">Резултат</h3>
          </div>
          <p class="text-[15px] leading-relaxed text-white/80">{{ project.result }}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{% if project.testimonial %}
<section class="section-pad bg-brand-mist">
  <div class="container-site">
    <div class="reveal mx-auto max-w-3xl text-center">
      <div class="eyebrow justify-center">Отзив</div>
      <blockquote class="mt-4 font-display text-[clamp(1.5rem,3vw,2.25rem)] font-extrabold leading-snug text-ink">
        „{{ project.testimonial }}“
      </blockquote>
      <p class="mt-6 text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">{{ project.location }} · {{ project.objectType }}</p>
      <button class="btn btn-primary mt-8 open-inquiry" type="button">Заяви подобен проект</button>
    </div>
  </div>
</section>
{% endif %}

{% include "sections/home-cta.njk" %}
