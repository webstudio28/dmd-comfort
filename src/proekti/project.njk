---
layout: base.njk
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/proekti/{{ project.slug }}/"
eleventyComputed:
  title: "{{ project.title }}"
  description: "{{ project.description or project.shortDescription }}"
  pageImage: "{% if project.images and project.images.length %}{{ project.images | first }}{% endif %}"
  pageImageAlt: "{{ project.title }}"
---
{% from "macros/page-banner.njk" import pageBanner %}
{% from "macros/breadcrumbs.njk" import breadcrumbs %}

{% call pageBanner() %}
  <div class="grid items-end gap-8 lg:grid-cols-2">
    <div>
      <div class="text-sm font-bold uppercase tracking-[0.14em] text-brand">{{ project.location }} · {{ project.objectType }}</div>
      <h1 class="mt-3 font-display text-[clamp(2.25rem,4.5vw,3.5rem)] font-black leading-none">{{ project.title }}</h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/70">{{ project.shortDescription }}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <button class="btn btn-primary open-inquiry" type="button">Заяви подобен проект</button>
      </div>
    </div>
    {% if project.images and project.images.length %}
      <div class="relative overflow-hidden rounded-2xl border border-white/10 shadow-lift">
        <img class="aspect-[4/3] w-full object-cover" src="{{ project.images[0] | url }}" alt="{{ project.title }}" />
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/35 to-transparent" aria-hidden="true"></div>
      </div>
    {% endif %}
  </div>
{% endcall %}

{% set group = project | projectGroup %}
{% if group %}
{{ breadcrumbs([
  { label: "Начало", url: "/" },
  { label: "Проекти", url: "/proekti/" },
  { label: group.title, url: group.href },
  { label: project.title }
]) }}
{% else %}
{{ breadcrumbs([
  { label: "Начало", url: "/" },
  { label: "Проекти", url: "/proekti/" },
  { label: project.title }
]) }}
{% endif %}

{% if project.images and project.images.length %}
<section class="section-pad bg-white">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal md:mb-12">
      <div class="eyebrow">Галерия</div>
      <h2 class="section-title">Снимки от обекта</h2>
      <p class="section-copy">Реални кадри от изпълнението и крайния резултат. Кликнете за уголемен преглед.</p>
    </div>
    <div class="project-gallery reveal grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 lg:grid-cols-5" data-gallery>
      {% for img in project.images %}
        <button
          type="button"
          class="project-gallery-item group relative overflow-hidden rounded-xl bg-brand-mist shadow-card"
          data-gallery-index="{{ loop.index0 }}"
          aria-label="Отвори снимка {{ loop.index }} от {{ project.images.length }}"
        >
          <img
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            src="{{ img | url }}"
            alt="{{ project.title }} - снимка {{ loop.index }}"
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </button>
      {% endfor %}
    </div>
  </div>
</section>
{% include "image-lightbox.njk" %}
{% endif %}

{% if project.videos and project.videos.length %}
<section class="section-pad overflow-x-clip bg-brand-mist">
  <div class="container-site">
    <div class="mb-10 max-w-2xl reveal md:mb-12">
      <div class="eyebrow">Видео</div>
      <h2 class="section-title">Видеа от обекта</h2>
      <p class="section-copy">Гледайте как протича работата и какъв е крайният резултат.</p>
    </div>
  </div>
  <div class="container-site max-md:contents">
    <div class="h-scroll reveal md:grid md:grid-cols-2 lg:grid-cols-3 md:gap-4">
      {% for video in project.videos %}
        {% set embedUrl = video.url | youtubeEmbed %}
        {% set ytId = video.url | youtubeId %}
        <figure class="overflow-hidden rounded-xl bg-white shadow-card">
          <div class="relative aspect-video overflow-hidden bg-brand-deeper">
            <button
              type="button"
              class="group absolute inset-0 grid place-items-center"
              data-video-embed="{{ embedUrl }}?autoplay=1&rel=0"
              data-video-title="{{ video.title or project.title }}"
              aria-label="Пусни видео{% if video.title %}: {{ video.title }}{% endif %}"
            >
              {% if ytId %}
                <img
                  class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                  src="https://i.ytimg.com/vi/{{ ytId }}/hqdefault.jpg"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              {% endif %}
              <span class="absolute inset-0 bg-gradient-to-t from-black/45 via-black/15 to-black/10 transition duration-300 group-hover:from-black/50" aria-hidden="true"></span>
              <span class="relative grid h-14 w-14 place-items-center rounded-full bg-white text-brand shadow-lift ring-1 ring-black/5 transition duration-300 group-hover:scale-110 group-hover:bg-brand group-hover:text-white" aria-hidden="true">
                <svg class="ml-0.5 h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86Z" />
                </svg>
              </span>
            </button>
          </div>
          {% if video.title %}
            <figcaption class="px-4 py-3">
              <h3 class="font-display text-base font-extrabold text-ink">{{ video.title }}</h3>
            </figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set linkedServices = project.serviceSlugs | servicesBySlugs %}
{% if linkedServices.length %}
<section class="section-pad bg-brand-mist" aria-labelledby="project-services-title">
  <div class="container-site">
    <div class="mb-8 max-w-2xl reveal md:mb-10">
      <div class="eyebrow">Свързани услуги</div>
      <h2 id="project-services-title" class="section-title">Услуги за този проект</h2>
      <p class="section-copy">Услуги от каталога, които отговарят на работата по този обект.</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {% for s in linkedServices %}
        <a class="card group flex items-center gap-3 p-3 no-underline reveal" href="{{ (s.href or ('/uslugi/' + s.slug + '/')) | url }}">
          <span class="relative h-16 w-[5.5rem] shrink-0 overflow-hidden rounded-lg bg-brand-soft">
            {% if s.image and not s.imageMissing %}
              <img class="image-cover" src="{{ s.image | url }}" alt="" loading="lazy" decoding="async" />
            {% endif %}
          </span>
          <span class="min-w-0 pr-1">
            <span class="block font-display text-base font-extrabold leading-snug text-ink group-hover:text-brand">{{ s.title }}</span>
            <span class="mt-1 block text-sm font-bold text-brand">Виж услугата</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set relatedProjects = project | relatedProjects %}
{% if relatedProjects.length and group %}
<section class="section-pad bg-white" aria-labelledby="related-projects-title">
  <div class="container-site mb-10 flex flex-col gap-6 reveal md:mb-12 md:flex-row md:items-end md:justify-between">
    <div>
      <div class="eyebrow">Още от категорията</div>
      <h2 class="section-title" id="related-projects-title">Още проекти от {{ group.title }}</h2>
      <p class="section-copy">Други реализирани обекти в същата категория.</p>
    </div>
    <a class="btn btn-primary shrink-0 self-start md:self-auto" href="{{ group.href | url }}">Всички от {{ group.title }}</a>
  </div>
  <div class="overflow-x-clip py-6 md:py-8">
    <div class="h-scroll-drag reveal" data-drag-scroll tabindex="0" role="region" aria-label="Още проекти от {{ group.title }} - плъзнете хоризонтално">
      {% for p in relatedProjects %}
        {% if p.images and p.images.length %}
          <a class="card group block no-underline" href="{{ ('/proekti/' + p.slug + '/') | url }}" draggable="false">
            <div class="relative m-2.5 aspect-[4/3] overflow-hidden rounded-lg">
              <img
                class="image-cover"
                src="{{ p.images[0] | url }}"
                alt="{{ p.title }}"
                width="640"
                height="480"
                loading="lazy"
                decoding="async"
                draggable="false"
              />
            </div>
            <div class="border-t border-ink/10 px-4 pb-5 pt-3.5">
              <h3 class="mb-1.5 font-display text-lg font-extrabold leading-snug text-ink group-hover:text-brand">{{ p.title }}</h3>
              <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{{ p.shortDescription }}</p>
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if project.testimonial %}
<section class="relative section-pad overflow-hidden bg-white">
  <div class="pointer-events-none absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-brand/5 blur-3xl" aria-hidden="true"></div>
  <div class="container-site relative">
    <div class="reveal grid items-stretch gap-10 lg:grid-cols-[minmax(0,1fr)_min(100%,17.5rem)] lg:gap-14">
      <figure class="min-w-0">
        <div class="eyebrow">Отзив</div>
        <blockquote class="mt-6 border-l-4 border-brand pl-6 md:pl-8">
          <p class="font-display text-[clamp(1.35rem,2.5vw,1.85rem)] font-bold leading-snug tracking-wide text-ink">
            „{{ project.testimonial }}“
          </p>
        </blockquote>
        <figcaption class="mt-6 flex flex-wrap items-center gap-3 pl-6 md:pl-8">
          <span class="h-px w-8 bg-brand" aria-hidden="true"></span>
          <span class="text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">{{ project.location }} · {{ project.objectType }}</span>
        </figcaption>
      </figure>
      <aside class="flex flex-col justify-between gap-6 border-t border-ink/10 pt-8 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <div>
          <p class="font-display text-lg font-extrabold text-ink">Искате подобен резултат?</p>
          <p class="mt-2 text-[15px] leading-relaxed text-ink-muted">Заявете оглед - ще предложим решение за вашия обект.</p>
        </div>
        <button class="btn btn-primary open-inquiry" type="button">Заяви подобен проект</button>
      </aside>
    </div>
  </div>
</section>
{% endif %}

{% include "sections/home-cta.njk" %}
