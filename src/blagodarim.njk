{% from "macros/page-banner.njk" import pageBanner %}

{% call pageBanner() %}
  <div class="eyebrow text-brand before:bg-brand">Запитване</div>
  <h1 class="mt-3 max-w-3xl font-display text-[clamp(2.5rem,5vw,3.75rem)] font-black leading-none">Благодарим ви!</h1>
