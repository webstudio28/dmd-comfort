    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a class="btn btn-primary" href="{{ site.contact.phoneHref }}">Обадете се: {{ site.contact.phone }}</a>
      <a class="btn btn-outline" href="{{ '/' | url }}">Към началото</a>
